# Copy to .env.local for local overrides. Neither variable is required to run
# the website — both exist for deployment.

# The public origin the site is served from. Set this once the real domain is
# live so link previews, canonical URLs and the sitemap point at it.
# On Vercel this is filled in automatically until you set it.
# NEXT_PUBLIC_SITE_URL=https://fixframe.example

# The CRM API base URL. Leave unset and the enquiry forms say they could not
# send and offer the studio email instead — which is the correct behaviour
# until the CRM is deployed. Locally, `npm run dev` assumes
# http://localhost:5180/api/v1 without needing this.
# NEXT_PUBLIC_API=https://api.fixframe.example/api/v1
